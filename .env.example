# Copiez ce fichier en `.env` (à la racine du projet) et remplissez les valeurs. `.env` n'est jamais commité.

# ---------------------------------------------------------------- Amazon Bedrock (assistant IA + débat des agents)
# Clés d'un utilisateur IAM ayant la permission bedrock:InvokeModel (console AWS → IAM → Utilisateurs → Clés d'accès).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Seulement si vous utilisez des identifiants temporaires (SSO / Workshop Studio du datathon) :
AWS_SESSION_TOKEN=
# Région AWS. us-east-1 a l'accès le plus large aux modèles Claude; ca-central-1 si le modèle y est activé.
AWS_REGION=us-east-1
AEGIS_BEDROCK_REGION=us-east-1
# Modèle Bedrock (console Bedrock → Model access : le modèle doit être activé pour votre compte).
AEGIS_AGENT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
AEGIS_SUPERVISOR_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ---------------------------------------------------------------- Application
# Nom affiché du produit (ex. le nom de la banque partenaire). Côté interface : VITE_APP_NAME dans frontend/.env
AEGIS_APP_NAME=AEGIS
# SEC EDGAR exige un User-Agent avec un contact réel (https://www.sec.gov/os/accessing-edgar-data)
AEGIS_SEC_USER_AGENT=AEGIS datathon prototype contact@votre-domaine.com
# Recherche externe en direct (SEC EDGAR, GDELT, CoinGecko, Banque du Canada)
AEGIS_WEB_RESEARCH_ENABLED=true
AEGIS_LLM_ENABLED=true
